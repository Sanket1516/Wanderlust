<!-- applying the ejs mate boilerplate to this file -->
<% layout("/../layouts/boilerplate") %>
<body>
    <h3>Listing Details</h3>
    <ul>
        <li><%=data.title%></li>
        <li><%=data.description%></li>
        <!-- we use new function to apply commas in numbers as per locallity
        and we pass the locallity as a parameter like india usa ,etc -->
        <li>&#8377; <%=data.price.toLocaleString("en-IN")%></li>
        <li><%=data.location%></li>
        <li><%=data.country%></li>
        <a href="/listings/<%=data._id%>/edit">Edit a post</a>
        <br>
        <br>
        <form method="post" action="/listings/<%=data._id%>?_method=DELETE">
            <button>Delete ME</button>
        </form>
    </ul>
</body>
