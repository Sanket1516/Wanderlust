<% layout("/../layouts/boilerplate") %>
<body>
    <h3>All Listing</h3>
    <!-- The 'row' class below is a Bootstrap utility that automatically aligns its child elements (the cards) horizontally in a row using flexbox. No extra CSS is needed for this alignment. -->

    <!-- The 'row' class creates a horizontal flex container for its child elements. 'row-cols-lg-3' sets 3 columns per row on large screens. 'row-cols-md-2' sets 2 columns per row on medium screens. 'row-cols-sm-1' sets 1 column per row on small screens. 'g-4' adds spacing (gutter) between columns and rows. All these are Bootstrap classes that make the grid responsive and well-spaced without extra CSS. -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
         <%for(let listing of allListings){%>
            <a href="/listings/<%=listing._id%>" class="listing_link">
        <div class="card col">
            <img src="<%=listing.image%>" class="card-img-top" alt="listing_image" style="height: 200px; object-fit: cover;">
            <div class="card-img-overlay"></div>
            <div class="card-body">
                <p class="card-text">
                    <b><%=listing.title%></b><br>
                    <%=listing.price.toLocaleString("en-IN") %> /night
                </p>
            </div>
        </div>
        </a>
    <%}%>
    </div>
    </div>

    <!-- <ul>
    <% for(let listing of allListings){ %>
        <li><a href="/listings/<%=listing.id%>"><%=listing.title%></a></li>
    <%}%>
</ul> -->
</body>

